export async function getMediaByDomain(domain: MediaDomain): Promise<MediaAsset[]> {
  // Имитация задержки сети
  await new Promise(resolve => setTimeout(resolve, 100));
  return mockMediaData[domain] || [];
}

export async function getMediaUrl(path: string): Promise<string> {
  // В мок-версии возвращаем путь как есть, добавляя префикс
  // Если путь уже содержит бакет (например, 'media/filename.jpg'), используем как есть
  // Иначе добавляем префикс '/photo/'
  if (!path) {
    throw new Error('Path is required for getMediaUrl');
  }
  
  if (path.includes('/')) {
    // Путь уже содержит бакет, используем как есть
    return path.startsWith('/') ? path : `/${path}`;
  } else {
    // Путь не содержит бакет, добавляем префикс '/photo/'
    return `/photo/${path}`;
  }
}

export async function getMediaById(id: string) {
  for (const domain in mockMediaData) {
    const item = mockMediaData[domain as MediaDomain].find(item => item.id === id);
    if (item) return item;
  }
  return null;
}

export async function insertMedia(mediaData: Omit<MediaAsset, 'id'> & { id?: string }) {
  console.log('Insert media (mock):', mediaData);
  return {
    id: mediaData.id || `mock-${Date.now()}`,
    ...mediaData,
  } as MediaAsset;
}

export async function updateMedia(id: string, updates: Partial<Omit<MediaAsset, 'id'>>) {
  console.log('Update media (mock):', id, updates);
  return;
}

export async function deleteMedia(id: string) {
  console.log('Delete media (mock):', id);
